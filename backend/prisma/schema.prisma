generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles allowed in the platform
enum Role {
  ADMIN
  PORTEIRO
  MORADOR
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String?
  passwordHash  String
  role          Role          @default(MORADOR)
  apartment     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  residents     ResidentInfo?
  packages      Package[]
  eventBookings EventBooking[]
}

model ResidentInfo {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @unique
  building  String?
  vehicle   String?
  emergencyContact String?
}

model Visitor {
  id           String    @id @default(cuid())
  name         String
  document     String
  phone        String?
  visitReason  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  logs         VisitLog[]
}

model VisitLog {
  id           String   @id @default(cuid())
  visitor      Visitor  @relation(fields: [visitorId], references: [id])
  visitorId    String
  host         User     @relation(fields: [hostId], references: [id])
  hostId       String
  entryTime    DateTime @default(now())
  exitTime     DateTime?
  notes        String?
  handledBy    User?    @relation("HandledBy", fields: [handledById], references: [id])
  handledById  String?
}

model Package {
  id            String        @id @default(cuid())
  code          String        @unique
  description   String
  carrier       String?
  receivedAt    DateTime      @default(now())
  retrievedAt   DateTime?
  resident      User          @relation(fields: [residentId], references: [id])
  residentId    String
  createdBy     User          @relation("PackageCreatedBy", fields: [createdById], references: [id])
  createdById   String
  retrievalLogs RetrievalLog[]
}

model RetrievalLog {
  id          String   @id @default(cuid())
  package     Package  @relation(fields: [packageId], references: [id])
  packageId   String
  verifiedBy  User     @relation(fields: [verifiedById], references: [id])
  verifiedById String
  verifiedAt  DateTime @default(now())
  method      String
}

model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  location    String
  capacity    Int
  startDate   DateTime
  endDate     DateTime
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdById String
  bookings    EventBooking[]
}

model EventBooking {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  resident  User     @relation(fields: [residentId], references: [id])
  residentId String
  notes     String?
  createdAt DateTime @default(now())
}
